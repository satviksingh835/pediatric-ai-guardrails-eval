# ============================================================
# Secrets — never commit
# ============================================================
.env
.env.*
!.env.example
*.key

# ============================================================
# Environments / caches
# ============================================================
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.DS_Store

# ============================================================
# Collaboration-owned research material (embargoed)
#
# The clinical case bank, guardrail checklist corpus and study
# protocol are the unpublished property of the research
# collaboration. Publishing them requires the clinical lead's
# sign-off. See docs/DATA_AVAILABILITY.md.
# ============================================================
data/private/

# Belt-and-braces: these filenames are embargoed wherever they appear,
# so a stray copy at the repo root can never be committed by accident.
/*.xlsx
/*.docx

# ============================================================
# Generated artifacts
#
# data/synthetic/ is rebuilt by tools/make_synthetic_fixture.py.
# Kept out of git so no binary blobs are versioned; the generator
# is committed instead. This is intentional, not an oversight.
# ============================================================
data/synthetic/
**/inputs.json

# Raw generation outputs embed full vignettes and verbatim model
# clinical advice from the unpublished study.
results/raw/
data/Engineering_Data_Package_ALLERGY_FULL_FINAL_v2.xlsx
